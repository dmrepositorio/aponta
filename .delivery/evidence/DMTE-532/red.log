      transform: scale(0);
      opacity: 1;
    }
    100% {
      transform: scale(4);
      opacity: 0;
    }
  }
}

/* DMTE-534: tipografia do corpo do artigo de Conhecimento. O Tailwind zera listas
   e títulos e o projeto não usa @tailwindcss/typography, então `prose` não faz
   nada. Escopado em .article-content para não mexer em DocsPage nem no editor. */
@layer components {
  .article-content {
    font-size: 0.875rem;
    line-height: 1.5rem;
    color: var(--color-gray-700);
    overflow-wrap: break-word;
  }
  .article-content > * + * {
    margin-top: 0.75rem;
  }
  .article-content h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    color: var(--color-gray-900);
    margin-top: 1.5rem;
  }
  .article-content h2 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    color: var(--color-gray-900);
    margin-top: 1.5rem;
  }
  .article-content h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: 1.25rem;
  }
  .article-content h4,
  .article-content h5,
  .article-content h6 {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-900);
    margin-top: 1rem;
  }
  .article-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }
  .article-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
  }
  .article-content ul ul {
    list-style-type: circle;
  }
  .article-content ol ol {
    list-style-type: lower-alpha;
  }
  .article-content li {
    margin-top: 0.25rem;
  }
  .article-content blockquote {
    border-left: 3px solid var(--color-brand-200);
    padding-left: 1rem;
    color: var(--color-gray-500);
  }
  .article-content a {
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-content a:hover {
    color: var(--color-brand-900);
  }
  .article-content a:focus-visible {
    outline: 2px solid var(--color-brand-300);
    outline-offset: 2px;
  }
  .article-content table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .article-content th,
  .article-content td {
    border: 1px solid var(--color-gray-200);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .article-content th {
    background-color: var(--color-gray-80);
    font-weight: 600;
  }
  .article-content img {
    max-width: 100%;
    height: auto;
    max-height: 24rem;
    object-fit: contain;
    border-radius: var(--radius-control);
  }
  .article-content code {
    background-color: var(--color-gray-80);
    border-radius: 4px;
    padding: 0.125rem 0.25rem;
    font-size: 0.8125rem;
  }
  .article-content pre {
    background-color: var(--color-gray-80);
    border-radius: var(--radius-control);
    padding: 0.75rem;
    overflow-x: auto;
  }
  .article-content pre code {
    background-color: transparent;
    padding: 0;
  }
  .article-content hr {
    border-top: 1px solid var(--color-gray-200);
  }
}
