# ─── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aponta
POSTGRES_PORT=5432

# ─── API (NestJS) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aponta?schema=public
JWT_SECRET=change-me-to-a-strong-secret-in-production
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Base dos links de convite e redefinição de senha enviados por e-mail (DMTE-550); sem ela esses e-mails não saem.
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Chave para cifrar o segredo do segundo fator (DMTE-551): um texto longo e aleatório, só no ambiente. Sem ela ninguém consegue ativar o segundo fator.
TWO_FACTOR_ENCRYPTION_KEY=
# Login social (DMTE-551): identificador e segredo do aplicativo criado em cada provedor. Sem os dois, o botão do provedor não aparece.
# Endereço de retorno a cadastrar no provedor: ${PUBLIC_APP_URL}/api/auth/social/<google|github>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ─── Web (Vite) ─────────────────────────────────────────────────────────
WEB_PORT=3000
VITE_API_URL=http://localhost:3001
